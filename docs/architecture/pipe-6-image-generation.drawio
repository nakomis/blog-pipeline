<mxfile host="app.diagrams.net">
  <diagram name="pipe-6-image-generation" id="pipe-6-image-generation">
    <mxGraphModel dx="1024" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="PIPE-6 — FLUX image generation (async, fal.ai webhook-driven)" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="20" width="560" height="30" as="geometry" />
        </mxCell>

        <mxCell id="smbox" value="Review loop (PIPE-3) — unchanged" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;verticalAlign=top;fontStyle=2;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="360" as="geometry" />
        </mxCell>
        <mxCell id="loaddraft" value="LoadDraft&#10;(status → reviewing)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="setoutcome" value="set-outcome&#10;(status → staged | failed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="submit" value="image-submit λ&#10;parse {{image}} tags;&#10;POST each missing image to fal queue&#10;(idempotent — skips PNGs already in S3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ssm" value="SSM&#10;${ssmPrefix}/image/fal" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="230" width="160" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fal" value="fal.ai queue&#10;fal-ai/flux-2-pro&#10;(generates server-side)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="630" y="110" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="callback" value="API Gateway  POST /image-callback&#10;(authType NONE, no API key)&#10;→ API Lambda · imageCallback module&#10;verify fal ED25519 sig (JWKS, ±300s)&#10;on raw body — 401 if bad" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="870" y="95" width="250" height="110" as="geometry" />
        </mxCell>

        <mxCell id="apply" value="applyPlaceholders (idempotent)&#10;{{image prompt=…}} → ![prompt](images/{slug}-n.png)&#10;only when status ≠ reviewing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="620" y="330" width="280" height="80" as="geometry" />
        </mxCell>

        <mxCell id="drafts" value="S3 drafts bucket&#10;{slug}/iteration-n/draft.md&#10;{slug}/images/{slug}-n.png" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="330" y="560" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jobs" value="DDB image-jobs&#10;requestId → slug, index, prompt&#10;(TTL ~7d)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="620" y="560" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="posts" value="DDB posts&#10;images[] {index, status, key}" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="910" y="560" width="200" height="80" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="loaddraft" target="submit">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e1l" value="async invoke" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e1"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="submit" target="ssm">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e2l" value="read key" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e2"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e3" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="submit" target="drafts">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e3l" value="read draft" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e3"><mxGeometry x="-0.3" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e4" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="submit" target="jobs">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e4l" value="write job row" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e4"><mxGeometry x="-0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="submit" target="fal">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e5l" value="POST ?fal_webhook=callback URL&#10;(Authorization: Key …)" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e5"><mxGeometry x="-0.1" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="fal" target="callback">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e6l" value="POST callback&#10;{request_id, status, images[0].url}&#10;(signed)" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e6"><mxGeometry x="-0.05" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e7" style="endArrow=block;html=1;fontSize=10;dashed=1;" edge="1" parent="1" source="callback" target="jobs">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e7l" value="lookup request_id" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e7"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e8" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="callback" target="drafts">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e8l" value="download → write PNG" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e8"><mxGeometry x="0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e9" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="callback" target="apply">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e9l" value="apply (image landed)" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e9"><mxGeometry x="0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e10" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="setoutcome" target="apply">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e10l" value="applyPlaceholders inline&#10;(out of review)" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e10"><mxGeometry x="-0.1" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e11" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="apply" target="drafts">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e11l" value="rewrite draft" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e11"><mxGeometry x="0" relative="1" as="geometry" /></mxCell>
        </mxCell>
        <mxCell id="e12" style="endArrow=block;html=1;fontSize=10;" edge="1" parent="1" source="apply" target="posts">
          <mxGeometry relative="1" as="geometry" />
          <mxCell id="e12l" value="update images[]" style="edgeLabel;html=1;" vertex="1" connectable="0" parent="e12"><mxGeometry x="0.2" relative="1" as="geometry" /></mxCell>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
