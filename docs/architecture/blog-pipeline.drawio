<mxfile host="app.diagrams.net">
  <diagram name="blog-pipeline" id="blog-pipeline-architecture">
    <mxGraphModel dx="1024" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Blog Pipeline — PIPE-1 dashboard read path" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="50" width="520" height="30" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="Browser&#10;(dashboard SPA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="80" y="360" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cloudfront" value="CloudFront&#10;distribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="340" y="170" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s3bucket" value="S3 bucket&#10;(SPA assets)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="580" y="170" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cognito" value="Cognito&#10;shared NakomisUserPool" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="310" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apicf" value="API CloudFront&#10;(injects x-api-key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="480" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="httpapi" value="REST API&#10;(API Gateway)&#10;Cognito authorizer + API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="340" y="470" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="lambda" value="Lambda&#10;list-posts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="580" y="475" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="dynamodb" value="DynamoDB&#10;PostsTable&#10;(by-status GSI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="470" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="GET / — SPA assets" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="browser" target="cloudfront">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="origin access control" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="cloudfront" target="s3bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="OIDC sign-in (hosted UI)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="browser" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="GET /posts + Bearer token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="browser" target="apicf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4b" value="forwards + x-api-key header" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="apicf" target="httpapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="validates JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=11;" edge="1" parent="1" source="httpapi" target="cognito">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="httpapi" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="Scan / Query by-status GSI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;" edge="1" parent="1" source="lambda" target="dynamodb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
