{
  "name": "blog-pipeline-infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK infrastructure for the blog content review pipeline",
  "bin": {
    "blog-pipeline": "bin/blog-pipeline.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --profile nakom.is-sandbox --all --require-approval never",
    "deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --profile nakom.is-admin --all --require-approval never",
    "ci-synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --all",
    "ci-deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --all --require-approval never --output cdk-deploy.out",
    "ci-deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --all --require-approval never --output cdk-deploy.out",
    "seed-sandbox": "NPM_ENVIRONMENT=sandbox ts-node scripts/seed-posts.ts",
    "seed-prod": "NPM_ENVIRONMENT=prod ts-node scripts/seed-posts.ts",
    "seed-draft-sandbox": "NPM_ENVIRONMENT=sandbox ts-node scripts/seed-draft.ts",
    "seed-draft-prod": "NPM_ENVIRONMENT=prod ts-node scripts/seed-draft.ts"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "aws-cdk": "^2.1019.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.24.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.108",
    "@ai-sdk/anthropic": "^3.0.79",
    "@ai-sdk/azure": "^3.0.66",
    "@ai-sdk/google": "^3.0.79",
    "@aws-sdk/client-dynamodb": "^3.731.0",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-sfn": "^3.1053.0",
    "@aws-sdk/client-ssm": "^3.1053.0",
    "@aws-sdk/lib-dynamodb": "^3.731.0",
    "ai": "^6.0.190",
    "aws-cdk-lib": "^2.190.0",
    "constructs": "^10.4.2",
    "zod": "^4.4.3"
  }
}
